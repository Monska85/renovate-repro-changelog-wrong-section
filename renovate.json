{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^deps\\.txt$/"],
      "matchStrings": ["(?<depName>[^@\\s]+)@(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ]
}
